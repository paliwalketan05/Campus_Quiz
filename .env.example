# Direct, unpooled PostgreSQL connections only.
# Application runtime URL; must connect as the restricted campusquiz_app role.
# Used by backend runtime and verify_and_migrate.py read-only status checks.
DATABASE_URL=postgresql://campusquiz_app:<password>@<direct-endpoint>/<database>?sslmode=require
APP_DATABASE_URL=postgresql://campusquiz_app:<password>@<direct-endpoint>/<database>?sslmode=require

# Privileged database owner / superuser connection URL.
# Required for executing schema migrations via database/verify_and_migrate.py (--migrate / --mark-applied).
# Never use the restricted campusquiz_app role for MIGRATION_DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://<database-owner>:<password>@<direct-endpoint>/<database>?sslmode=require

# Must match the active auth_hmac_secret stored in app_auth_config.
AUTH_HMAC_SECRET=<random secret matching app_auth_config; at least 32 bytes>

# Independent JWT signing secret; generate a random value of at least 32 bytes.
JWT_SECRET_KEY=<different random secret; at least 32 bytes>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit frontend origins only; comma-separated when more than one is needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Use AUTH_COOKIE_SAMESITE=none only for cross-site frontend/API deployments, and keep Secure enabled.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Optional parent domain when frontend and API share a registrable domain.
# AUTH_COOKIE_DOMAIN=example.edu
